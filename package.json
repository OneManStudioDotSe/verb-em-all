{
  "name": "verb-em-all",
  "version": "1.1.0",
  "description": "A Pok\u00e9mon-style desktop app for catching unusual verbs you meet while coding",
  "homepage": "https://github.com/OneManStudioDotSe/verb-em-all",
  "repository": {
    "type": "git",
    "url": "https://github.com/OneManStudioDotSe/verb-em-all.git"
  },
  "bugs": "https://github.com/OneManStudioDotSe/verb-em-all/issues",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:all": "npm run build && electron-builder --mac --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run"
  },
  "keywords": [
    "electron",
    "vocabulary",
    "verbs"
  ],
  "author": "Sotiris Falieris (One Man Studio)",
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.0.0": true
  }
}
